# ============================================================
#  Toyota CMS -- ortam degiskenleri
#  Bu dosyayi ".env" adiyla kopyala ve degerleri doldur.
#  .env ASLA git'e girmez (.gitignore'da).
# ============================================================

# --- ZORUNLU ---------------------------------------------------

# Oturum cerezlerini imzalar. Uzun ve rastgele olmali.
# Uretmek icin:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# DIKKAT: yayindayken bunu degistirirsen tum oturumlar duser.
FLASK_SECRET_KEY=

# Panelin gizli adresi. Basinda "/" olacak, sonunda OLMAYACAK.
# Tahmin edilemesin diye sonuna rastgele bir ek koy.
ADMIN_PATH=/panel-8f3a2c9d

# Sifrenin HASH'i -- duz sifre DEGIL.
# Uretmek icin:  python tools/hash_password.py
ADMIN_PASSWORD_HASH=

# --- OPSIYONEL (varsayilanlar gosteriliyor) --------------------

ADMIN_SESSION_MINUTES=60      # oturum omru (dolunca sifre tekrar sorulur)
ADMIN_MAX_ATTEMPTS=5          # kac hatali denemeden sonra kilit
ADMIN_LOCK_MINUTES=15         # kilit suresi

# Veritabani. Goreli sqlite yolu instance/ altina yazilir.
DATABASE_URL=sqlite:///toyota.db

# Gorsel yukleme ust siniri (MB)
UPLOAD_MAX_MB=4

# --- YAYINA ALIRKEN --------------------------------------------

# HTTPS kurulduktan SONRA true yap. Once yaparsan panele giremezsin.
SESSION_COOKIE_SECURE=false

# nginx / Caddy gibi bir ters proxy arkasindaysan true yap.
# (Yoksa IP kilidi tum ziyaretcileri tek IP sanar.)
TRUST_PROXY=false

# SQLite WAL modu. Yayinda true onerilir; OneDrive/Dropbox gibi
# senkronize edilen bir klasorde calisiyorsan false birak.
SQLITE_WAL=false

# --- DAVRANIS ANAHTARLARI --------------------------------------

# Harita tesis metinleri (sehir/ulke/uretilen) cevrilsin mi?
# Bugunku site cevirmiyor -- false birakmak gorunumu birebir korur.
MAP_MARKERS_TRANSLATABLE=false

# Gizli panel adresi robots.txt'ye yazilsin mi?
# false = yazilmaz (onerilen; robots.txt herkese acik, adresi ifsa eder).
# Panel zaten X-Robots-Tag ve <meta robots noindex> ile korunuyor.
ROBOTS_DISCLOSE_ADMIN=false
