# ============================================================
#  Toyota tanitim sitesi -- ortam degiskenleri
#  Bu dosyayi ".env" adiyla kopyala ve degerleri doldur.
#  .env ASLA git'e girmez (.gitignore'da).
#
#  Site .env olmadan da calisir; asagidakilerin hepsi opsiyoneldir.
#  Icerik kodda (app/icerik/), veritabani yok.
# ============================================================

# Dil secimini tasiyan cerezi imzalar. Yayinda uzun ve rastgele olmali.
# Uretmek icin:  python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=

# --- YAYINA ALIRKEN --------------------------------------------

# HTTPS kurulduktan SONRA true yap.
SESSION_COOKIE_SECURE=false

# nginx / Caddy gibi bir ters proxy arkasindaysan true yap.
TRUST_PROXY=false
